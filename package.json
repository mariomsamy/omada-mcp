{
    "name": "omada-mcp",
    "version": "1.0.0",
    "description": "Security-focused Model Context Protocol server for TP-Link Omada Open API workflows",
    "type": "module",
    "main": "dist/index.js",
    "bin": {
        "omada-mcp": "./dist/index.js"
    },
    "scripts": {
        "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
        "lint": "biome check --error-on-warnings .",
        "lint:fix": "biome check --write .",
        "format": "biome format --write .",
        "check": "npm run lint && tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "dev": "tsx src/index.ts",
        "start": "node dist/index.js",
        "inspector": "tsx scripts/run-inspector.ts",
        "inspector:build": "npm run build && tsx scripts/run-inspector.ts build",
        "docker:build": "docker build -f Dockerfile -t omada-mcp:local .",
        "docker:run": "docker run --rm -it --env-file .env --env-file .env.local omada-mcp:local",
        "prepare": "echo skip"
    },
    "files": ["dist/", "README.md", "README.Docker.md", "CHANGELOG.md", "LICENSE", ".env.example", "SECURITY.md", "docs/operations/", "docs/support-matrix.md", "docs/security-model.md"],
    "keywords": ["mcp", "tp-link", "omada"],
    "engines": {
        "node": ">=24.0.0"
    },
    "author": "mariomsamy and contributors (see NOTICE.md)",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mariomsamy/omada-mcp.git"
    },
    "homepage": "https://github.com/mariomsamy/omada-mcp#readme",
    "bugs": {
        "url": "https://github.com/mariomsamy/omada-mcp/issues"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.32.2",
        "axios": "^1.21.0",
        "dotenv": "^18.0.9",
        "pino": "^10.4.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.4",
        "@modelcontextprotocol/inspector": "^2.13.0",
        "@types/node": "^26.6.6",
        "@vitest/coverage-v8": "^5.1.0",
        "@vitest/ui": "^5.1.0",
        "concurrently": "^10.0.6",
        "husky": "^9.1.7",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vitest": "^5.1.0"
    }
}
